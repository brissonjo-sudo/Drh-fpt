{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Traces de consultation DRH-FPT",
  "type": "object",
  "required": ["consultations"],
  "additionalProperties": false,
  "properties": {
    "consultations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "source_url",
          "consulted_at",
          "version_or_date",
          "supporting_excerpt",
          "conclusion_supported",
          "source_id",
          "reference_date",
          "endpoint",
          "request",
          "raw_response_file",
          "raw_response_sha256"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri", "minLength": 1},
          "source_id": {"type": "string"},
          "consulted_at": {"type": "string", "format": "date-time"},
          "version_or_date": {"type": "string", "minLength": 1},
          "supporting_excerpt": {"type": "string", "minLength": 1},
          "conclusion_supported": {"type": "string", "minLength": 1},
          "source_title": {"type": "string"},
          "article_number": {"type": "string", "minLength": 1},
          "kind": {"enum": ["decision", "jorf", "official_page", "consolidated_structure"]},
          "excerpt_extractor": {"enum": ["visible-html-v1"]},
          "reference_date": {"type": "string", "format": "date"},
          "endpoint": {"enum": ["/consult/legiPart", "/consult/juri", "/consult/jorf", "https"]},
          "request": {"type": "object"},
          "raw_response_file": {"type": "string", "minLength": 1},
          "raw_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
